{
  "name": "deepseek-usage",
  "displayName": "DeepSeek Usage",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "deepseekUsage.showStats",
        "title": "%command.showStats%"
      },
      {
        "command": "deepseekUsage.startProxy",
        "title": "%command.startProxy%"
      },
      {
        "command": "deepseekUsage.stopProxy",
        "title": "%command.stopProxy%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "deepseekUsage.port": {
          "type": "number",
          "default": 8080,
          "description": "%config.port%"
        },
        "deepseekUsage.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoStart%"
        },
        "deepseekUsage.manageBaseUrl": {
          "type": "boolean",
          "default": true,
          "description": "%config.manageBaseUrl%"
        },
        "deepseekUsage.pollIntervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "description": "%config.pollIntervalSeconds%"
        },
        "deepseekUsage.language": {
          "type": "string",
          "enum": ["auto", "en", "zh-cn"],
          "default": "auto",
          "description": "%config.language%"
        }
      }
    }
  },
  "scripts": {
    "compile": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild smoke.ts --bundle --format=cjs --platform=node --outfile=out/smoke.js && node out/smoke.js",
    "vscode:prepublish": "node build.js --production"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
